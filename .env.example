# SSO Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uniga_sso?schema=public"

# JWT secret for SSO tokens — GANTI dengan nilai acak yang kuat di production!
SSO_JWT_SECRET="ganti-dengan-secret-acak-yang-kuat"

# Login dengan Google (opsional — tombol baru muncul jika CLIENT_ID & SECRET terisi)
# Buat OAuth client (Web application) di Google Cloud Console.
# Authorized redirect URI: https://<domain-sso>/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI=""          # default: <origin>/auth/google/callback
# ALLOWED_EMAIL_DOMAIN="unigamalang.ac.id"
